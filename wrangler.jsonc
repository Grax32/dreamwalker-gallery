{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamwalker-gallery",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["dreamwalker-gallery@vt-hub.win"]
    }
  ],
  "routes": [
    {
      "pattern": "dreamwalkergallery.com",
      "custom_domain": true
    },
    {
      "pattern": "www.dreamwalkergallery.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}