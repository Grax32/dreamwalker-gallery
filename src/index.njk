---
layout: layouts/base.njk
title: The DreamWalker Gallery
---

<section class="hero-section">
  <div class="hero-content">
    <h1>The DreamWalker Gallery</h1>
    <p>Where imagination, digital art, and photography blend into surreal worlds of creativity.</p>
  </div>
</section>

<section class="gallery-section">
  <div class="gallery-intro">
    <h2>Featured Artworks</h2>
    <p>Explore our collection of {{ gallery.length }} surreal and imaginative pieces</p>
  </div>
  
  <div class="gallery-grid">
    {% for item in gallery %}
      {% set galleryItem = item %}
      {% include "gallery-item.njk" %}
    {% endfor %}
  </div>
</section>
