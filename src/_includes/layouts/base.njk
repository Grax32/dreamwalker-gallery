<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ title or "The DreamWalker Gallery" }}</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    {% if pageStyles %}<link rel="stylesheet" href="{{ pageStyles }}">{% endif %}
  </head>
  <body class="gallery-container{% if bodyClass %} {{ bodyClass }}{% endif %}">
    {% include "header.njk" %}
    <main class="gallery-main">
      {{ content | safe }}
    </main>
    {% include "footer.njk" %}
    {% if pageScript %}<script src="{{ pageScript }}" defer></script>{% endif %}
    <script>
      // Hero transparency on scroll
      function updateHeroTransparency() {
        const heroSection = document.querySelector('.hero-section');
        if (!heroSection) return;
        
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        const heroHeight = heroSection.offsetHeight;
        
        // Calculate coverage percentage (0 = not covered, 1 = fully covered)
        const coveragePercent = Math.min(scrollTop / heroHeight, 1);
        
        // Calculate opacity based on requirements:
        // 25% covered (0.25) = 50% transparent (0.5 opacity)
        // 50% covered (0.5) = fully transparent (0 opacity)
        let opacity = 1;
        if (coveragePercent >= 0.5) {
          opacity = 0; // Fully transparent at 50% coverage or more
        } else if (coveragePercent >= 0.25) {
          // Linear interpolation from 50% to 0% opacity between 25% and 50% coverage
          opacity = 1 - ((coveragePercent - 0.25) / 0.25) * 1;
        } else if (coveragePercent > 0) {
          // Linear interpolation from 100% to 50% opacity between 0% and 25% coverage
          opacity = 1 - (coveragePercent / 0.25) * 0.5;
        }
        
        heroSection.style.opacity = opacity;
      }
      
      // Update on scroll and load
      window.addEventListener('scroll', updateHeroTransparency);
      window.addEventListener('load', updateHeroTransparency);
      document.addEventListener('DOMContentLoaded', updateHeroTransparency);
    </script>
  </body>
</html>
